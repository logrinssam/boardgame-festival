rules_version = '2';

/**
 * Functions(Admin SDK)가 예약을 쓰고, 클라이언트는 읽기 위주.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staffAssignments/$(request.auth.uid));
    }

    function isActiveStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staffAssignments/$(request.auth.uid))
        && staffDoc().data.isActive == true;
    }

    function isHeadAdmin() {
      return isActiveStaff() && staffDoc().data.role == 'HEAD_ADMIN';
    }

    match /booths/{boothId} {
      allow read: if true;
      allow write: if false;
    }

    match /reservations/{reservationId} {
      allow read: if isActiveStaff();
      allow write: if false;
    }

    match /walkInRegistrations/{registrationId} {
      allow read: if isActiveStaff();
      allow write: if false;
    }

    match /staffAssignments/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /staffLoginIndex/{loginId} {
      allow read: if true;
      allow write: if false;
    }

    match /operationLogs/{logId} {
      allow read: if isActiveStaff();
      allow write: if false;
    }

    // 부스 현장코드 — 참가자는 절대 읽을 수 없다. 본부는 전체, 팀장은 담당 부스만.
    match /boothSecrets/{boothId} {
      allow read: if isActiveStaff()
        && (isHeadAdmin() || boothId in staffDoc().data.assignedBoothIds);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
